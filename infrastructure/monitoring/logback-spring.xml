<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="agentos"/>
    <springProperty scope="context" name="LOKI_URL" source="agentos.observability.loki.url" defaultValue="http://loki:3100/loki/api/v1/push"/>

    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="ch.qos.logback.contrib.json.classic.JsonLayout">
                <timestampFormat>yyyy-MM-dd'T'HH:mm:ss.SSSZ</timestampFormat>
                <appendLineSeparator>true</appendLineSeparator>
                <jsonFormatter class="ch.qos.logback.contrib.jackson.JacksonJsonFormatter">
                    <prettyPrint>false</prettyPrint>
                </jsonFormatter>
            </layout>
        </encoder>
    </appender>

    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${LOKI_URL}</url>
        </http>
        <format>
            <label>
                <pattern>app=${APP_NAME},level=%level,trace_id=%X{trace_id:-}</pattern>
            </label>
            <message>
                <pattern>{"@timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ}","level":"%level","logger":"%logger{36}","thread":"%thread","trace_id":"%X{trace_id:-}","message":"%msg"}</pattern>
            </message>
        </format>
        <batchSize>100</batchSize>
        <batchTimeoutMs>1000</batchTimeoutMs>
        <maxRetries>3</maxRetries>
        <minDelayMs>500</minDelayMs>
        <maxDelayMs>5000</maxDelayMs>
    </appender>

    <appender name="ASYNC_LOKI" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="LOKI"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="vip.mate" level="DEBUG"/>
        <logger name="org.springframework.ai" level="DEBUG"/>
    </springProfile>

    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </root>
        <logger name="vip.mate" level="INFO"/>
        <logger name="org.springframework.ai" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>
    </springProfile>

    <springProfile name="postgres">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_LOKI"/>
        </root>
        <logger name="vip.mate" level="DEBUG"/>
        <logger name="org.springframework.ai" level="INFO"/>
    </springProfile>

    <turboFilter class="ch.qos.logback.classic.turbo.MarkerFilter">
        <Marker>SENSITIVE</Marker>
        <OnMatch>DENY</OnMatch>
    </turboFilter>
</configuration>