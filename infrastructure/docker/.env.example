# AgentOS 环境变量配置
# 复制此文件为 .env 并填写实际值：cp .env.example .env

# ==================== 数据库（必填） ====================
DB_NAME=agentos
DB_USERNAME=agentos
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ==================== 对象存储（必填） ====================
S3_ACCESS_KEY=agentos
S3_SECRET_KEY=CHANGE_ME_STRONG_SECRET_KEY

# ==================== 安全（必填） ====================
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS

# ==================== 监控（可选） ====================
GRAFANA_PASSWORD=admin123